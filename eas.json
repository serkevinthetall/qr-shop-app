{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://qr-shop-app-backend.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://qr-shop-app-backend.vercel.app"
      }
    },
    "local-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalReportRelease -x lintVitalRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.qrshop.online",
        "EXPO_PUBLIC_API_FALLBACK_URL": "https://qrshopmyanmar.netlify.app",
        "ORG_GRADLE_JVMARGS": "-Xmx4096m -XX:MaxMetaspaceSize=1024m -Dfile.encoding=UTF-8"
      }
    },
    "local-aab": {
      "distribution": "store",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalReportRelease -x lintVitalRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.qrshop.online",
        "EXPO_PUBLIC_API_FALLBACK_URL": "https://qrshopmyanmar.netlify.app",
        "ORG_GRADLE_JVMARGS": "-Xmx4096m -XX:MaxMetaspaceSize=1024m -Dfile.encoding=UTF-8"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.qrshop.online",
        "EXPO_PUBLIC_API_FALLBACK_URL": "https://qrshopmyanmar.netlify.app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      },
      "ios": {
        "ascAppId": "6800218923"
      }
    }
  }
}

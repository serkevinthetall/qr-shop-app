{
  "expo": {
    "name": "QR Shop",
    "slug": "qr-shop-app",
    "version": "1.4.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "qrapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qrshop.myanmar",
      "googleServicesFile": "./GoogleService-Info.plist",
      "appStoreUrl": "https://apps.apple.com/app/id6800218923",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["viber", "fb", "tel", "itms-apps"]
      },
      "buildNumber": "24"
    },
    "android": {
      "package": "com.qrshop.myanmar",
      "versionCode": 26,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.qrshop.myanmar",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "networkInspector": false
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class io.invertase.firebase.** { *; }\n-keep class com.google.firebase.** { *; }\n-keep class com.google.android.gms.** { *; }\n-dontwarn com.google.firebase.**\n-dontwarn com.google.android.gms.**\n-keep class com.qrshop.myanmar.network.** { *; }\n-keepclassmembers class com.qrshop.myanmar.network.** { *; }",
            "manifestQueries": {
              "package": ["com.viber.voip", "com.facebook.katana", "com.facebook.lite"]
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QR App to access your photos to upload payment screenshots."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "./plugins/with-rnfb-ios-fix.js",
      "./plugins/with-android-play-compliance.js",
      "./plugins/with-okhttp-doh.js",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "776d0c6d-e886-4053-9dba-89fa5c3bef58"
      }
    },
    "owner": "serkevin"
  }
}
